---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Social card copy, when it should differ from the meta description. */
  ogDescription?: string;
  noindex?: boolean;
  /** JSON-LD structured data, embedded as a <script type="application/ld+json"> block. */
  schema?: Record<string, unknown>;
}

const SITE_URL = "https://bhavleensingh.com";
const OG_IMAGE = { url: `${SITE_URL}/bhavleen-singh.jpg`, width: 690, height: 1007 };

// Fonts for above-the-fold text: the hero headline ("Bhavleen" / "Singh."), intro paragraph,
// and DM Mono for the nav, hero label and credentials (otherwise discovered only after CSS parses).
const PRELOAD_FONTS = [
  "/fonts/playfair-display-normal-latin.woff2",
  "/fonts/playfair-display-italic-latin.woff2",
  "/fonts/source-serif-4-normal-latin.woff2",
  "/fonts/dm-mono-normal-400-latin.woff2",
  "/fonts/dm-mono-normal-500-latin.woff2",
];

const { title, description, ogDescription = description, noindex = false, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bhavleen Singh" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {PRELOAD_FONTS.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <!-- Lets CSS hide scroll-reveal content only when the script that reveals it can run. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Google tag (gtag.js). The page view is queued straight away, but the 170 KB library
         is requested only once the page has loaded AND its first contentful paint has been
         presented. As a plain async script it could finish before first paint, delaying LCP
         and adding long tasks on slow phones. load alone isn't enough: on this small page it
         can fire before the first paint. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CHC87EF4GD');
      addEventListener('load', function () {
        var requested = false;
        function loadTag() {
          if (requested) return;
          requested = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-CHC87EF4GD';
          document.head.appendChild(s);
        }
        try {
          new PerformanceObserver(function (list, observer) {
            if (list.getEntriesByName('first-contentful-paint').length) {
              observer.disconnect();
              setTimeout(loadTag, 0);
            }
          }).observe({ type: 'paint', buffered: true });
        } catch (e) {}
        // Fallback for browsers without Paint Timing, or a tab that hasn't painted yet.
        setTimeout(loadTag, 3000);
      });
    </script>

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
