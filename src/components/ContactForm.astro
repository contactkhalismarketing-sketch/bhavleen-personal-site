---
/*
 * ContactForm — submits via Formspree (free, no backend needed)
 * Connected to Formspree: https://formspree.io/f/mnjgygrb
 * Styled for Editorial Minimalism dark contact section
 *
 * The form posts to Formspree natively, so it still works without JavaScript;
 * the script below upgrades it to an in-place submit with loading/success/error states.
 */
import Icon from "./Icon.astro";

const FORM_ENDPOINT = "https://formspree.io/f/mnjgygrb";

const ENQUIRY_TYPES = [
  "SEO Audit",
  "Monthly SEO Retainer",
  "Local SEO",
  "Technical SEO",
  "Content Strategy",
  "SEO Consulting",
  "Recruitment / Opportunity",
  "Other",
];

const labelBase = "block font-['DM_Mono'] text-xs uppercase tracking-widest mb-1.5";
const labelStyle = "color: rgba(248,245,240,0.45)";
---

<div class="contact-form">
  <div
    data-form-success
    hidden
    class="p-10 flex flex-col items-center justify-center text-center min-h-[420px]"
    style="background: rgba(248,245,240,0.04); border: 1px solid rgba(201,135,58,0.2)"
  >
    <Icon name="CheckCircle2" size={40} class="mb-5" style="color: #C9873A" />
    <h3 class="font-['Playfair_Display'] text-2xl font-bold mb-3" style="color: #F8F5F0">
      Message received.
    </h3>
    <p class="font-['Source_Serif_4'] text-sm leading-relaxed mb-6 max-w-xs" style="color: rgba(248,245,240,0.6)">
      Thanks for reaching out. I'll get back to you within 1–2 business days.
    </p>
    <button
      type="button"
      data-form-reset
      class="font-['DM_Mono'] text-xs uppercase tracking-widest underline underline-offset-2"
      style="color: #C9873A"
    >
      Send another message
    </button>
  </div>

  <div
    data-form-panel
    class="p-8 lg:p-10"
    style="background: rgba(248,245,240,0.04); border: 1px solid rgba(201,135,58,0.15)"
  >
    <h3 class="font-['Playfair_Display'] text-2xl font-bold mb-1" style="color: #F8F5F0">
      Send a Message
    </h3>
    <p class="font-['Source_Serif_4'] text-sm mb-8" style="color: rgba(248,245,240,0.45)">
      I typically respond within 1–2 business days.
    </p>

    <form id="contact-form" action={FORM_ENDPOINT} method="POST" class="space-y-5">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="contact-name" class={labelBase} style={labelStyle}>
            Your Name <span style="color: #C9873A">*</span>
          </label>
          <input id="contact-name" type="text" name="name" required placeholder="Jane Smith" autocomplete="name" class="contact-input" />
        </div>
        <div>
          <label for="contact-email" class={labelBase} style={labelStyle}>
            Email Address <span style="color: #C9873A">*</span>
          </label>
          <input id="contact-email" type="email" name="email" required placeholder="jane@company.com" autocomplete="email" class="contact-input" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="contact-website" class={labelBase} style={labelStyle}>
            Website URL
          </label>
          <input id="contact-website" type="url" name="website" placeholder="https://yoursite.com.au" autocomplete="url" class="contact-input" />
        </div>
        <div>
          <label for="contact-enquiry" class={labelBase} style={labelStyle}>
            Enquiry Type
          </label>
          <select id="contact-enquiry" name="enquiryType" class="contact-input">
            <option value="" style="background: #1A1A1A">Select…</option>
            {ENQUIRY_TYPES.map((t) => <option value={t} style="background: #1A1A1A">{t}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label for="contact-message" class={labelBase} style={labelStyle}>
          Message <span style="color: #C9873A">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="5"
          placeholder="Tell me a bit about your business and what you're looking to achieve with SEO…"
          class="contact-input"
        ></textarea>
      </div>

      <div data-form-error hidden class="flex items-center gap-2 text-sm font-['DM_Mono']" style="color: #f87171" role="alert">
        <Icon name="AlertCircle" size={14} />
        Something went wrong. Please try emailing directly.
      </div>

      <button
        type="submit"
        data-form-submit
        class="contact-submit w-full flex items-center justify-center gap-2 font-['DM_Mono'] text-xs uppercase tracking-widest"
      >
        <span data-form-idle class="flex items-center gap-2"><Icon name="Send" size={13} /> Send Message</span>
        <span data-form-loading hidden class="flex items-center gap-2"><Icon name="Loader2" size={14} class="animate-spin" /> Sending…</span>
      </button>

      <p class="font-['DM_Mono'] text-xs text-center" style="color: rgba(248,245,240,0.25)">
        No spam. No pressure. Just a conversation.
      </p>
    </form>
  </div>
</div>

<style>
  .contact-input {
    width: 100%;
    background: rgba(248, 245, 240, 0.05);
    border: 1px solid rgba(201, 135, 58, 0.25);
    border-radius: 1px;
    padding: 0.75rem 1rem;
    color: #f8f5f0;
    font-family: "Source Serif 4", serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .contact-input:focus {
    border-color: #c9873a;
  }
  select.contact-input {
    appearance: none;
  }
  textarea.contact-input {
    resize: vertical;
  }
  .contact-submit {
    background: #c9873a;
    color: #f8f5f0;
    padding: 0.9rem 2rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .contact-submit:disabled {
    background: #9a6428;
    cursor: not-allowed;
  }
</style>

<script>
  type Status = "idle" | "loading" | "success" | "error";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const root = form?.closest<HTMLElement>(".contact-form");

  if (form && root) {
    const find = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const panel = find("[data-form-panel]");
    const success = find("[data-form-success]");
    const error = find("[data-form-error]");
    const submit = find<HTMLButtonElement>("[data-form-submit]");
    const idleLabel = find("[data-form-idle]");
    const loadingLabel = find("[data-form-loading]");

    const setStatus = (status: Status) => {
      panel.hidden = status === "success";
      success.hidden = status !== "success";
      error.hidden = status !== "error";
      submit.disabled = status === "loading";
      idleLabel.hidden = status === "loading";
      loadingLabel.hidden = status !== "loading";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setStatus("loading");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (res.ok) {
          form.reset();
          setStatus("success");
        } else {
          setStatus("error");
        }
      } catch {
        setStatus("error");
      }
    });

    find("[data-form-reset]").addEventListener("click", () => setStatus("idle"));
  }
</script>
